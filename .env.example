# Copia este archivo a ".env" y llena los valores. NUNCA subas ".env" a GitHub.

# Cadena de conexión de MongoDB Atlas (Connect > Drivers). Cambia <password> y pon el nombre de la base antes del "?"
MONGODB_URI=mongodb+srv://USUARIO:<password>@cluster0.xxxxx.mongodb.net/juegos?retryWrites=true&w=majority

# Texto largo y aleatorio para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Puerto local (Render pone el suyo automáticamente)
PORT=3000
